# Local dev API base (Vite proxies /api to localhost:5000)
VITE_API_BASE_URL=/api/v1

# Production API base URL — set at build time on Vercel, e.g.
# VITE_API_URL=https://your-backend.onrender.com/api/v1
VITE_API_URL=

# Set "true" ONLY for local development to show the password login for DEV test accounts (hidden in production)
VITE_ENABLE_DEV_LOGIN=false