# ==========================================
# CAMPUS TRAINING PORTAL - ENVIRONMENT VARS
# ==========================================

# Server & Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=training_portal_db
DB_SSL=false

# Authentication & JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Brevo Transactional Email & OTP
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_email@domain.com
BREVO_SENDER_NAME=TrainX Training Portal

# AI Services (Gemini / Groq)
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.6-flash
Groq_AI_API_KEY=your_groq_api_key_here

# Super Admin Initial Credentials
SUPER_ADMIN_EMAIL=admin@trainingportal.com
SUPER_ADMIN_PASSWORD=your_secure_superadmin_password
