# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=training_portal_db

# JWT Configuration (use a long random string, minimum 32 characters)
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Email / Nodemailer SMTP Configuration
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Campus Training Portal" <your_email@gmail.com>

# Google Gemini AI Configuration
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
