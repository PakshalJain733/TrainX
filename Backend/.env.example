# ==========================================
# TrainX Backend Environment Configuration Template
# ==========================================
# COPY THIS FILE TO .env AND FILL IN YOUR REAL CREDENTIALS.
# NEVER COMMIT .env OR REAL API KEYS TO GIT REPOSITORIES.

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=training_portal_db
DB_SSL=false

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Email Delivery Configuration (SMTP Primary, Brevo Backup)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=TrainX

# Brevo (Transactional Email Backup Service)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME=TrainX (Training Portal)

# AI Service Configuration
AI_API_KEY=your_ai_api_key_here
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
Groq_AI_API_KEY=your_groq_api_key_here

# Super Admin Configuration (Credentials & Profile loaded from .env)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@trainingportal.com
SUPER_ADMIN_PASSWORD=your_secure_superadmin_password_here
SUPER_ADMIN_MOBILE=9876543210

# Webhook Secrets
C2C_WEBHOOK_SECRET=your_c2c_webhook_secret_key_here

# ==========================================
# Career Gateway Integration (S2S Machine-to-Machine)
# ==========================================
# Inbound authentication: Secret used to verify incoming JWT requests from Career Gateway
CAREER_GATEWAY_SERVICE_SECRET=your_career_gateway_inbound_s2s_secret_here

# Partner Integration API Key (Bearer token accepted by sync endpoints)
TRAINX_API_KEY=your_trainx_partner_api_key_here
CAREER_GATEWAY_INTEGRATION_TOKEN=your_career_gateway_integration_token_here

# Outbound destination: Career Gateway receiver API base URL
CAREER_GATEWAY_API_URL=https://staging-api.careergateway.edu

# Outbound authentication: Secret used by TrainX to sign JWTs when pushing daily training sync to Career Gateway
TRAINX_TO_CAREER_GATEWAY_SECRET=your_trainx_outbound_s2s_secret_here

# Agreed external college slug for Career Gateway receiver validation
CAREER_GATEWAY_COLLEGE_ID=col_somaiya_eng_01

# Optional: Set to true to disable the 2:00 AM IST daily training sync worker (e.g. on test/dev environments)
DISABLE_CAREER_GATEWAY_SCHEDULER=false

# System Health & Monitoring Configuration
HEALTH_CHECK_TIMEOUT_MS=3500
HEALTH_CHECK_INTERVAL_MS=30000
SYSTEM_METRICS_ENABLED=true
