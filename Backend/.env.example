# ==========================================
# TrainX Backend Environment Configuration Template
# ==========================================
# COPY THIS FILE TO .env AND FILL IN YOUR REAL CREDENTIALS.
# NEVER COMMIT .env OR REAL API KEYS TO GIT REPOSITORIES.

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=training_portal_db
DB_SSL=false

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Brevo (Transactional Email Service)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME=TrainX (Training Portal)

# AI Service Configuration
AI_API_KEY=your_ai_api_key_here
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
Groq_AI_API_KEY=your_groq_api_key_here

# Initial Super Admin Seed Credentials
SUPER_ADMIN_EMAIL=admin@trainingportal.com
SUPER_ADMIN_PASSWORD=admin123

# Webhook Secrets
C2C_WEBHOOK_SECRET=your_c2c_webhook_secret_key_here
